{
  "project": {
    "name": "API Migration Evaluation - Pre-Change vs Post-Change Analysis",
    "version": "1.0.0",
    "scope": "AI Model Evaluation - Feature & Improvement (API Change)",
    "date_created": "2025-11-07",
    "canonical_scenario": "Commerce platform migrating inventory checks from /api/v1/checkStock to /api/v2/stock/availability"
  },
  "structure": {
    "root_files": [
      {
        "name": "README.md",
        "purpose": "Comprehensive documentation with all instructions",
        "size": "comprehensive"
      },
      {
        "name": "QUICKSTART.md",
        "purpose": "Quick reference for common tasks",
        "size": "short"
      },
      {
        "name": "test_data.json",
        "purpose": "Shared canonical test data (6 test cases)",
        "test_cases": 6
      },
      {
        "name": "run_all.sh",
        "purpose": "Master execution script (macOS/Linux)",
        "execution": "bash run_all.sh"
      },
      {
        "name": "run_all.bat",
        "purpose": "Master execution script (Windows)",
        "execution": "run_all.bat"
      },
      {
        "name": "generate_comparison_report.py",
        "purpose": "Generate comparison markdown report",
        "output": "results/compare_report.md"
      }
    ],
    "project_a": {
      "name": "Project_A_PreChange",
      "title": "Legacy v1 Integration",
      "description": "Pre-change state calling /api/v1/checkStock endpoint",
      "api_endpoint": "POST /api/v1/checkStock",
      "directories": {
        "src": {
          "files": [
            {
              "name": "cart_service_v1.py",
              "class": "CartServiceV1",
              "methods": [
                "check_stock(sku, quantity)",
                "add_to_cart(sku, quantity, cart_id)",
                "get_request_log()"
              ],
              "features": [
                "Simple stock check",
                "No region awareness",
                "Synchronous response",
                "Basic timeout handling"
              ]
            }
          ]
        },
        "mocks": {
          "files": [
            {
              "name": "mock_v1_server.py",
              "type": "Flask application",
              "endpoints": [
                "POST /api/v1/checkStock",
                "GET /health",
                "GET /metrics"
              ],
              "port": 8001,
              "features": [
                "In-memory inventory database",
                "Latency tracking",
                "No region awareness"
              ]
            }
          ]
        },
        "tests": {
          "files": [
            {
              "name": "test_pre_change.py",
              "class": "TestPreChangeV1",
              "test_methods": 8,
              "test_cases": [
                "TC001: Normal availability",
                "TC002: Boundary condition",
                "TC003: Async baseline (sync only)",
                "TC004: Permissive validation",
                "TC005: Error handling",
                "TC006: Out of stock",
                "CART-ADD-SUCCESS",
                "CART-ADD-OOS"
              ]
            }
          ]
        },
        "data": {
          "files": [
            "sample_payload_tc001.json",
            "validation_differences.json"
          ]
        },
        "results": {
          "files": [
            "results_pre.json"
          ]
        },
        "logs": {
          "files": [
            "v1_server.log",
            "test_run.log",
            "test_output.log"
          ]
        }
      },
      "execution": {
        "setup": "bash setup.sh (or setup.bat on Windows)",
        "run_tests": "bash run_tests.sh (or run_tests.bat on Windows)",
        "output": "results/results_pre.json"
      }
    },
    "project_b": {
      "name": "Project_B_PostChange",
      "title": "Updated v2 Integration with Advanced Features",
      "description": "Post-change state calling /api/v2/stock/availability with async support",
      "api_endpoint": "POST /api/v2/stock/availability",
      "directories": {
        "src": {
          "files": [
            {
              "name": "cart_service_v2.py",
              "class": "CartServiceV2",
              "methods": [
                "check_stock_v2(sku, quantity, region_id, warehouse_group, enable_async_polling)",
                "add_to_cart(sku, quantity, region_id, warehouse_group, cart_id)",
                "get_request_log()"
              ],
              "features": [
                "Region-aware inventory",
                "Async polling (202 Accepted)",
                "Exponential backoff retry (100ms, 200ms, 400ms)",
                "Circuit breaker (open after 5 failures)",
                "Fallback to v1 or safe default",
                "Strict input validation",
                "Request deduplication tracking"
              ],
              "design_patterns": [
                "Adapter pattern",
                "Circuit breaker pattern",
                "Retry pattern with exponential backoff",
                "Fallback strategy"
              ]
            }
          ]
        },
        "mocks": {
          "files": [
            {
              "name": "mock_v2_server.py",
              "type": "Flask application",
              "endpoints": [
                "POST /api/v2/stock/availability",
                "GET /api/v2/stock/availability/poll/{request_id}",
                "GET /health",
                "GET /metrics"
              ],
              "port": 8002,
              "features": [
                "Region awareness (ap-sg-1, us-east-1, eu-west-1)",
                "Warehouse group validation (WG-1, WG-2, WG-3)",
                "Async simulation (20% of requests return 202)",
                "Polling endpoint for async results",
                "Strict parameter validation",
                "Latency tracking",
                "Configurable responses"
              ]
            }
          ]
        },
        "tests": {
          "files": [
            {
              "name": "test_post_change.py",
              "class": "TestPostChangeV2",
              "test_methods": 10,
              "test_cases": [
                "TC001: Normal with region",
                "TC002: Boundary with region",
                "TC003: Async polling",
                "TC004a: Validation (missing region)",
                "TC004b: Validation (invalid warehouse)",
                "TC005: Error handling with fallback",
                "TC006: Out of stock with region",
                "CART-ADD-REGION",
                "CART-ADD-OOS-REGION",
                "CIRCUIT-BREAKER"
              ]
            }
          ]
        },
        "data": {
          "files": [
            "sample_async_polling.json"
          ]
        },
        "results": {
          "files": [
            "results_post.json"
          ]
        },
        "logs": {
          "files": [
            "v2_server.log",
            "test_run.log",
            "test_output.log"
          ]
        }
      },
      "execution": {
        "setup": "bash setup.sh (or setup.bat on Windows)",
        "run_tests": "bash run_tests.sh (or run_tests.bat on Windows)",
        "output": "results/results_post.json"
      }
    },
    "results": {
      "name": "results/",
      "files": [
        {
          "name": "results_pre.json",
          "source": "Project_A_PreChange/results/",
          "content": "v1 test execution results"
        },
        {
          "name": "results_post.json",
          "source": "Project_B_PostChange/results/",
          "content": "v2 test execution results"
        },
        {
          "name": "aggregated_metrics.json",
          "generated_by": "generate_comparison_report.py",
          "content": "Combined metrics and statistics"
        },
        {
          "name": "compare_report.md",
          "generated_by": "generate_comparison_report.py",
          "content": "Comprehensive comparison analysis with recommendations"
        }
      ]
    }
  },
  "test_coverage": {
    "total_test_cases": 6,
    "test_cases": [
      {
        "id": "TC001",
        "title": "Normal Case - Immediate Confirmed Availability",
        "validates": "Basic parameter mapping, response schema, availability logic",
        "coverage": ["immediate response", "successful inventory check"]
      },
      {
        "id": "TC002",
        "title": "Boundary Case - Exact Quantity Threshold",
        "validates": "Edge case handling, threshold correctness",
        "coverage": ["exact match", "boundary conditions"]
      },
      {
        "id": "TC003",
        "title": "Asynchronous/Partial Case - Pending with Polling",
        "validates": "Async handling, polling logic, eventual consistency",
        "coverage": ["202 Accepted response", "polling retry", "eventual consistency"]
      },
      {
        "id": "TC004",
        "title": "Invalid/Malformed Input Case",
        "validates": "Input validation, error handling, fallback",
        "coverage": ["missing parameters", "invalid values", "type validation"]
      },
      {
        "id": "TC005",
        "title": "High-Latency/Error Case - Timeout and Retry",
        "validates": "Retry logic, circuit breaker, resilience",
        "coverage": ["timeouts", "500 errors", "exponential backoff", "circuit breaker"]
      },
      {
        "id": "TC006",
        "title": "Out of Stock Case",
        "validates": "Inventory boundary at zero, status messaging",
        "coverage": ["out of stock", "insufficient quantity", "status codes"]
      }
    ],
    "cart_integration_tests": [
      "CART-ADD-SUCCESS: Successful item addition",
      "CART-ADD-OOS: Out-of-stock prevention",
      "CART-ADD-REGION: Region-aware cart addition",
      "CIRCUIT-BREAKER: Resilience under failures"
    ]
  },
  "dependencies": {
    "python_version": "3.8+",
    "packages": [
      "flask==3.0.0",
      "requests==2.31.0",
      "pytest==7.4.3",
      "pytest-cov==4.1.0",
      "python-dotenv==1.0.0"
    ]
  },
  "execution_flow": {
    "step1": "run_all.sh/bat starts",
    "step2": "Project A setup and tests execute",
    "step3": "Project A results saved to results_pre.json",
    "step4": "Project B setup and tests execute",
    "step5": "Project B results saved to results_post.json",
    "step6": "Results copied to shared results/ directory",
    "step7": "generate_comparison_report.py generates comparison",
    "step8": "Outputs: compare_report.md, aggregated_metrics.json",
    "total_expected_duration": "30-60 seconds"
  },
  "output_files": {
