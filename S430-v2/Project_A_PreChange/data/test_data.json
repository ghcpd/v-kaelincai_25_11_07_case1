[
  {
    "id": "normal",
    "description": "Normal — v1 returns confirmed availability",
    "input": {"sku":"ABC123","quantity":1,"regionId":null,"warehouseGroup":null},
    "expected": {"http_status":200,"available":true,"quantity":12,"fallback":false}
  },
  {
    "id": "boundary_zero",
    "description": "Boundary — quantity 0 returns out of stock",
    "input": {"sku":"ABC123","quantity":0},
    "expected": {"http_status":200,"available":false,"quantity":0,"fallback":false}
  },
  {
    "id": "invalid_input",
    "description": "Invalid/malformed — missing sku or non-string",
    "input": {"sku": 12345,"quantity":1},
    "expected": {"http_status":200,"available":false,"quantity":0,"fallback":false}
  },
  {
    "id": "server_error",
    "description": "High-latency / error — v1 returns 500",
    "input": {"sku":"ERRSKU","quantity":1},
    "expected": {"http_status":200,"available":false,"quantity":0,"fallback":false}
  },
  {
    "id": "boundary_reserve",
    "description": "Boundary — reserve threshold (qty == reserve threshold)",
    "input": {"sku":"ABC123","quantity":5},
    "expected": {"http_status":200,"available":true,"quantity":12,"fallback":false}
  }
]
