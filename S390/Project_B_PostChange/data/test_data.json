[
  {
    "id": "normal",
    "description": "Normal case - v2 returns confirmed availability immediately",
    "input": {"sku":"ABC123","regionId":"ap-sg-1","warehouseGroup":"WG-2"},
    "expected": {"http_status":200, "available":true, "quantity":12}
  },
  {
    "id": "boundary_zero",
    "description": "Boundary case - quantity 0",
    "input": {"sku":"ZERO","regionId":"ap-sg-1","warehouseGroup":"WG-2"},
    "expected": {"http_status":200, "available":false, "quantity":0}
  },
  {
    "id": "pending_then_confirm",
    "description": "Asynchronous pending case - v2 returns pending then confirmed after timestamp",
    "input": {"sku":"PEND","regionId":"ap-sg-1","warehouseGroup":"WG-2"},
    "expected": {"http_status":200, "available":true, "quantity":2}
  },
  {
    "id": "malformed",
    "description": "Invalid/malformed inputs - missing regionId",
    "input": {"sku":"ABC123","warehouseGroup":"WG-2"},
    "expected": {"http_status":400, "available":false}
  },
  {
    "id": "high_latency_error",
    "description": "High latency or error - v2 times out, expect fallback to v1",
    "input": {"sku":"SLOW","regionId":"ap-sg-1","warehouseGroup":"WG-2"},
    "expected": {"http_status":200, "available":true, "quantity":1, "note_contains":"fallback"}
  }
]
